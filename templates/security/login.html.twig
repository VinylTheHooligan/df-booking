{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Connexion{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block body %}
    {% if error %}
        <div class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="assertive" aria-atomic="true">
            <div class="toast align-items-center text-bg-danger border-0" role="alert" data-bs-autohide="true" data-bs-delay="4000" data-controller="toast">
                <div class="d-flex">
                    <div class="toast-body">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>  
        </div>
    {% endif %}
    <div class="bg-login d-flex">
        <div class="justify-content-center w-100">

        </div>
        <div class="d-flex justify-content-center align-items-center vh-100 w-100">
            <div class="col-md-6">
                <form method="post">
                    <fieldset class="d-flex flex-column">
                        <h1 class="align-self-center text-light mb-3 font-weight-normal h1-title">Connexion</h1>
                        <div class="mb-3">
                            <label class="login-label form-label text-light" for="username">Email</label>
                            <input class="form-control" type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label class="login-label form-label text-light" for="password">Mot de passe</label>
                            <input class="form-control" type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                        </div>
                        <div class="form-check checkbox mb-3">
                            <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
                            <label class="login-label form-check-label text-light shadow-sm" for="_remember_me">Se souvenir de moi</label>
                        </div>
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                        <button class="btn btn-lg btn-primary mt-4 mx-4 text-light" type="submit">Se connecter</button>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
