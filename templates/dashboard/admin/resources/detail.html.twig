{% extends 'dashboard/_dashboard.html.twig' %}

{% block title %}{{ parent() }} - {{ resource.name }}{% endblock %}

{% block content %}
    {% set isEnabled = resource.isEnabled %}
    <div>
        <h1>{{ resource.name }}</h1>

        <hr>

        <dl>
            <div class="d-flex flex-row my-4">
                <div class="w-100">
                    <dt>ID :</dt>
                    <dd>{{ resource.id }}</dd>

                    <dt>Description :</dt>
                    <dd>{{ resource.description }}</dd>

                    <dt>Type :</dt>
                    <dd>{{ resource.resourceType }}</dd>

                    <dt>Créer le :</dt>
                    <dd>{{ resource.createdAt|date("d/m/Y à H:i", "Europe/Paris") }}</dd>
                </div>
                <div class="w-100">
                    <dt>Capacité humaine :</dt>
                    <dd>{{ resource.capacity }}</dd>
                
                    <dt>Localisation :</dt>
                    <dd>{{ resource.location.adress }}</dd>
                
                    <dt>Est fonctionnel :</dt>
                    <dd>{{ isEnabled ? 'Oui' : 'Non' }}</dd>
                </div>
            </div>
        </dl>

        <hr>

        <dl>
            <dt>Équipement(s) disponible :</dt>
            <dd>
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Quantité</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for equipment in resource.equipments %}
                            <tr>
                                <td>
                                    {{ equipment.equipment.name }}
                                </td>
                                <td>
                                    {{ equipment.quantity }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </dd>
        </dl>
        
        <div class="d-flex gap-3 mt-5">
            <a type="button" class="btn btn-outline-secondary me-5" href="{{ path('app_admin_resources') }}">Retour</a>

            <a type="button" class="btn btn-outline-primary" href="{{ path('app_admin_resources_modify', { id: resource.id }) }}">Modifier</a>

            <button type="button" class="btn btn-outline-warning"
                data-controller="trigger"
                data-action="click->trigger#open"
                data-trigger-title="{% if isEnabled %}Désactiver{% else %}Activer{% endif %} la ressource"
                data-trigger-body="Souhaitez-vous vraiment {% if isEnabled %}désactiver{% else %}activer{% endif %} cette ressource ?"
                data-trigger-btn-label="Oui"
                data-trigger-btn-variant="warning"
                data-trigger-url="{{ path('app_admin_resources_toggle', { id: resource.id }) }}">
                {% if isEnabled %}Désactiver{% else %}Activer{% endif %}
            </button>

            <form method="post" action="{{ path('app_admin_resources_delete', { id: resource.id, token: csrf_token('delete-resource-' ~ resource.id) }) }}">
                <button type="button" class="btn btn-outline-danger"
                    data-controller="trigger" 
                    data-action="click->trigger#open" 
                    data-trigger-title="Supprimer la ressource"
                    data-trigger-body="Souhaitez-vous vraiment supprimer cette ressource ?"
                    data-trigger-btn-label="Oui"
                    data-trigger-btn-variant="danger"
                    data-trigger-action="submit">
                    Supprimer
                </button>
            </form>
        </div>
    </div>
{% endblock %}
