{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Tableau de bord{% endblock %}

{% block body %}
    <div class="d-flex min-vh-100">

        <nav data-controller="sidebar" data-sidebar-target="sidebar" id="sidebar" class="sidebar bg-light shadow-lg d-flex flex-column p-3">
            <button data-action="sidebar#toggle" id="sidebarTab" class="sidebar-tab">☰</button>
            {% include "dashboard/_sidebar.html.twig" %}
        </nav>
        
        <main class="flex-grow-1">
            <div class="m-5">{% block content %}{% endblock %}</div>
        </main>

    </div>
{% endblock %}